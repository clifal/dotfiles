{
  "model": "opus[1m]",
  "skillOverrides": {},
  "syncClaudeAiSkills": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"セッション開始時、最初の応答前に Skill ツールで genshijin:genshijin を呼び出し、原始人モード(強度:通常)を有効化せよ。\"}}'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "genshijin@genshijin": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    }
  },
  "effortLevel": "high",
  "theme": "dark",
  "switchModelsOnFlag": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "cleanupPeriodDays": 30
}
