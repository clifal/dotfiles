{
  "cleanupPeriodDays": 30,
  "syncClaudeAiSkills": false,
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skill-guard/skill-guard.sh hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "genshijin@genshijin": true,
    "mattpocock-skills@claude-plugins-official": true,
    "yomiyasu@yomiyasu": true
  },
  "extraKnownMarketplaces": {
    "genshijin": {
      "source": {
        "source": "github",
        "repo": "InterfaceX-co-jp/genshijin"
      }
    },
    "yomiyasu": {
      "source": {
        "source": "github",
        "repo": "nanaism/yomiyasu"
      }
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "theme": "dark",
  "switchModelsOnFlag": false
}
